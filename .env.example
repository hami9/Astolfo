# Every setting the bot reads, with its real default. Copy to .env and change
# what you need - nothing here is required except the two values at the top.
#
# Anything set here can be overridden at runtime from the bot's own panel, and
# the stored value wins. Use `panel -> settings -> reset one to the .env value`
# to hand a setting back to this file.

# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- ownership ---
# Whoever this is gets /panel in their private chat: services, settings, groups,
# people, server. A numeric id settles it; leave it empty and the first person
# whose username matches is claimed once, then only their id counts.
# Find yours with @userinfobot.
# MASTER_ID=
# MASTER_USERNAME=ham1235i
# ADMIN_IDS=11111111,22222222   # extra ids trusted for the /chance, /mode, /reset group commands

# --- models (OpenRouter ids) ---
MODEL_FAST=google/gemini-2.5-flash
MODEL_THINK=google/gemini-2.5-pro
MODEL_SEARCH=google/gemini-2.5-flash
MODEL_MEDIA=google/gemini-2.5-flash
MODEL_ROUTER=google/gemini-2.5-flash-lite
MODEL_SUMMARY=google/gemini-2.5-flash-lite
FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku
# PROVIDER_SORT=price          # let OpenRouter prefer the cheapest provider

# Stack several services, tried in this order. Each grants its own free quota, so
# together they last far longer than one. A service is used only when its key is
# set, and any endpoint or model list can be overridden, e.g. GROQ_BASE_URL,
# GOOGLE_MODELS, MISTRAL_VISION_MODELS.
# Keys can also be added from the bot's own panel, where they are stored
# encrypted and a service can hold more than one. What is here stays the fallback.
PROVIDERS=openrouter
# GOOGLE_API_KEY=              # aistudio.google.com
# GROQ_API_KEY=                # console.groq.com
# GITHUB_MODELS_TOKEN=         # a GitHub token with models access
# CEREBRAS_API_KEY=            # cloud.cerebras.ai
# MISTRAL_API_KEY=             # console.mistral.ai
# COHERE_API_KEY=              # dashboard.cohere.com (trial keys are free)
# HUGGINGFACE_API_KEY=         # huggingface.co/settings/tokens
# SAMBANOVA_API_KEY=           # cloud.sambanova.ai
# DEEPINFRA_API_KEY=           # deepinfra.com (paid after the signup credit)
# AIMLAPI_API_KEY=             # aimlapi.com (small free allowance, then paid)
# PINNED_SERVICE=              # use only this one; empty = the usual failover order

# --- free mode (no credit required) ---
FREE_MODE=0                    # 1 = use OpenRouter's zero-cost models only
# FREE_MODELS=                 # optional: pin specific ids instead of discovering them
FREE_RPM=8                     # shared requests/minute; free limits count per account

# --- chat behaviour ---
BOT_LANG=en                    # language of command replies: en | fa
PERSONA_LOCALE=auto            # few-shot example set: auto | en | fa
REPLY_MODE=smart               # manual | auto | smart (per group in the panel)
GROUP_REPLY_CHANCE=0.30        # chance of joining a conversation unprompted
MEDIA_REPLY_CHANCE=0.75        # chance of reacting to photos, voice, video
REPLY_COOLDOWN=20              # seconds between unprompted replies in one chat
ATTENTION_HOLD=90              # after joining in, other chats get less of it for this long
INTEREST_SCORING=1             # join a topic on what was said, not on a coin flip
ADAPTIVE_LENGTH=1              # shorten replies the budget or the chat does not reward
HEAVY_LIFTING=0                # 1 lets it attempt homework, heavy maths and whole programs
READ_ADMINS=1                  # look up who runs each group, for context only
MAX_HISTORY=80                 # turns kept per chat in memory
HISTORY_CHAR_BUDGET=9000       # characters of history sent to the model
MAX_INPUT_CHARS=1200           # a longer message is truncated before it is sent
PERSONA_REINJECT=8             # re-inject the persona reminder every N turns

# --- answer quality ---
ROUTER_LLM=1                   # LLM dispatcher for ambiguous messages
ROUTER_MAX_TOKENS=80
ROUTER_MIN_WORDS=4             # shorter messages never reach the dispatcher
WEB_SEARCH=1                   # web search for verifiable questions
WEB_MAX_RESULTS=4
SHOW_SOURCES=1
THINK_EFFORT=medium            # low | medium | high
FAST_REASONING_BUDGET=0        # thinking tokens in fast mode; 0 disables it
TEMPERATURE_FAST=0.95
TEMPERATURE_THINK=0.55
TEMPERATURE_GROUNDED=0.25
MAX_TOKENS_FAST=160
MAX_TOKENS_THINK=900

# --- credit controls ---
DAILY_BUDGET_USD=0             # 0 = unlimited; otherwise degrade then stop
MONTHLY_BUDGET_USD=0
CHAT_DAILY_CALL_LIMIT=0        # 0 = unlimited model calls per chat per day
USER_DAILY_CALL_LIMIT=0        # the same, per person; the panel sets either one by hand
RESPONSE_CACHE=1               # reuse the answer to an identical recent message
RESPONSE_CACHE_TTL=600
ROUTER_CACHE_TTL=3600
PROMPT_CACHE_CONTROL=1         # cache breakpoints for providers that need them
TRACK_COST=1                   # ask OpenRouter to return per-call cost

# --- donations (Telegram Stars) ---
DONATE=1                       # /donate sends a Stars invoice; no gateway needed
DONATE_AMOUNTS=15,50,150       # suggested amounts, first one is the default

# --- memory ---
SUMMARIES=1                    # fold old turns into long-term notes
RETAIN_DAYS=90                 # drop the audit trail, day counters and people
                               # nobody has seen since; 0 keeps everything
CHAT_TTL=43200                 # seconds a silent chat is kept in memory
MAX_CHATS=800                  # LRU bound; a chat mid-reply is never evicted

# --- media ---
MEDIA_ENABLED=1
MAX_MEDIA_BYTES=20971520       # 20 MB, Telegram's own download limit
IMAGE_MAX_DIM=1024
IMAGE_QUALITY=82
VIDEO_FRAMES=4
MAX_AUDIO_SECONDS=240

# --- network ---
REQUEST_TIMEOUT=90
MAX_RETRIES=4

# --- runtime ---
DATA_DIR=data                  # database, encryption key and usage history
KEEPALIVE=1                    # tiny HTTP endpoint for uptime pingers
PORT=8080
LOG_LEVEL=INFO
# APP_TITLE=Astolfo Telegram Bot
# APP_URL=https://github.com/hami9/Astolfo
