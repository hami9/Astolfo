# --- الزامی ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# --- مدل‌ها (اختیاری؛ شناسه‌های OpenRouter) ---
MODEL_FAST=google/gemini-2.5-flash
MODEL_THINK=google/gemini-2.5-pro
MODEL_SEARCH=google/gemini-2.5-flash
MODEL_MEDIA=google/gemini-2.5-flash
MODEL_ROUTER=google/gemini-2.5-flash-lite
MODEL_SUMMARY=google/gemini-2.5-flash-lite
FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# --- رفتار ---
GROUP_REPLY_CHANCE=0.30      # احتمال ورود خودکار به بحث گروه
MEDIA_REPLY_CHANCE=0.75      # احتمال واکنش به عکس/ویس/ویدیو
REPLY_COOLDOWN=20            # ثانیه بین دو پاسخ خودکار در یک گروه
MAX_HISTORY=24
PERSONA_REINJECT=8           # هر چند نوبت یادآور شخصیت تزریق شود

# --- کیفیت پاسخ ---
ROUTER_LLM=1                 # مسیریاب هوشمند سریع/تفکر/سرچ
WEB_SEARCH=1                 # جست‌وجوی وب برای کاهش توهم
WEB_MAX_RESULTS=4
SHOW_SOURCES=1
THINK_EFFORT=medium          # low | medium | high
TEMPERATURE_FAST=0.95
TEMPERATURE_THINK=0.55
TEMPERATURE_GROUNDED=0.25

# --- رسانه ---
MEDIA_ENABLED=1
IMAGE_MAX_DIM=1152
VIDEO_FRAMES=5

# --- متفرقه ---
SUMMARY_ENABLED=1
KEEPALIVE=1
PORT=8080
LOG_LEVEL=INFO
# ADMIN_IDS=11111111,22222222
